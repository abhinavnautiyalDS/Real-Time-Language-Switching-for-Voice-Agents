[Unit]
Description=Standalone Multilingual Language Classifier API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/multilingual-classifier/backend
EnvironmentFile=/opt/multilingual-classifier/backend/.env
ExecStart=/opt/multilingual-classifier/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8011 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
